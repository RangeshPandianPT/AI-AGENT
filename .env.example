# IGRIS Environment Configuration
# Copy this file to .env and fill in your API keys

# Hugging Face API Key (get from https://huggingface.co/settings/tokens)
HF_API_KEY=your_huggingface_api_key_here

# Google Gemini API Key (optional, get from https://makersuite.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# LiveKit Configuration (for original agent.py)
LIVEKIT_URL=your_livekit_url
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
